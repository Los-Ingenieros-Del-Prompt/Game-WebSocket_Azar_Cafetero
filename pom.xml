<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.aguardientes.azarcafetero</groupId>
	<artifactId>game</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>game</name>
	<description>Demo project for Spring Boot</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Sonar -->
		<sonar.organization>los-ingenieros-del-prompt</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.coverage.jacoco.xmlReportPaths>
			${project.build.directory}/site/jacoco/jacoco.xml
		</sonar.coverage.jacoco.xmlReportPaths>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- Apache HttpClient for connection pooling -->
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.11</version>

				<configuration>
					<excludes>
						<!-- Clase main -->
						<exclude>**/GameApplication.class</exclude>
						<!-- DTOs de WebSocket (sin lógica) -->
						<exclude>**/infrastructure/websocket/dto/**</exclude>
						<!-- DTOs de clientes externos -->
						<exclude>**/infrastructure/client/dto/**</exclude>
						<!-- Configuración de infraestructura -->
						<exclude>**/infrastructure/config/**</exclude>
						<!-- Configuración de WebSocket -->
						<exclude>**/infrastructure/websocket/WebSocketConfig.class</exclude>
						<!-- Tarea de limpieza programada -->
						<exclude>**/infrastructure/tasks/TableCleanupTask.class</exclude>
						<!-- Controladores WebSocket y REST (integración, no unitarios) -->
						<exclude>**/infrastructure/websocket/TableWebSocketController.class</exclude>
						<exclude>**/infrastructure/websocket/WebSocketEventListener.class</exclude>
						<exclude>**/infrastructure/web/TableController.class</exclude>
						<!-- Cliente REST externo -->
						<exclude>**/infrastructure/client/RestLobbyPlayerClient.class</exclude>
					</excludes>
				</configuration>

				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>

					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>

					<execution>
						<id>check-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<excludes>
								<exclude>**/GameApplication.class</exclude>
								<exclude>**/infrastructure/websocket/dto/**</exclude>
								<exclude>**/infrastructure/client/dto/**</exclude>
								<exclude>**/infrastructure/config/**</exclude>
								<exclude>**/infrastructure/websocket/WebSocketConfig.class</exclude>
								<exclude>**/infrastructure/tasks/TableCleanupTask.class</exclude>
								<exclude>**/infrastructure/websocket/TableWebSocketController.class</exclude>
								<exclude>**/infrastructure/websocket/WebSocketEventListener.class</exclude>
								<exclude>**/infrastructure/web/TableController.class</exclude>
								<exclude>**/infrastructure/client/RestLobbyPlayerClient.class</exclude>
							</excludes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
